# Backend environment reference. For Docker run infra/docker/init-env.sh, which writes a git-ignored docker.env (never commit it).
APP_ENV=local                      # local | test | staging | production
# App connection: the least-privilege role, via Neon's POOLED host (contains -pooler).
DATABASE_URL=postgresql+psycopg://healthcare_runtime:CHANGE_ME@HOST:5432/DB?sslmode=require
# Migration connection: the schema OWNER via Neon's DIRECT host. Required when APP_ENV=production.
DATABASE_MIGRATION_URL=postgresql+psycopg://OWNER:CHANGE_ME@HOST:5432/DB?sslmode=require
DATABASE_CONNECT_TIMEOUT=10        # seconds; raise for scale-to-zero databases
SESSION_HMAC_KEY=                  # python -c "import secrets; print(secrets.token_urlsafe(48))"
FIELD_ENCRYPTION_KEYS=             # Fernet key(s): 32 random bytes, urlsafe base64 (44 chars). NOT token_urlsafe(48). First key encrypts; back them all up
COOKIE_DOMAIN=                     # host of the frontend, e.g. your-app.vercel.app
CSRF_ALLOWED_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=https://your-app.vercel.app
PUBLIC_APP_URL=https://your-app.vercel.app
SENTRY_DSN=                        # required when APP_ENV=production
STORAGE_BACKEND=local              # supabase in production
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=               # https://<frontend>/api/v1/auth/google/callback
RUN_MIGRATIONS_ON_START=false      # true applies migrations at container start (owner URL)
