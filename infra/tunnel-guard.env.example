# Copy to infra/tunnel-guard.env and fill in. Keep this file OUT of git.
# Create a token at https://vercel.com/account/tokens
VERCEL_TOKEN=
VERCEL_PROJECT=healthcare-crm
VERCEL_TEAM=httpsgithubcomwaleed260codedebugger
API_URL_ENV_KEY=API_URL
TUNNEL_CONTAINER=clinic-tunnel-1
CHECK_INTERVAL=60
SITE_URL=https://web-eight-flax-pmiw08soee.vercel.app
# Optional: a Vercel Deploy Hook URL (Project → Settings → Git → Deploy Hooks)
# If set, it is used to trigger redeploys instead of the deployments API.
VERCEL_DEPLOY_HOOK=
